# REST API (when set, worker/company flows call the backend instead of local Zustand mocks)
# Vercel: set as VITE_API_BASE_URL so the browser can read it.
VITE_API_BASE_URL=
# Optional non-prefixed alias (not exposed by Vite unless mirrored in vite.config define)
API_BASE_URL=

# Supabase — browser must use VITE_ prefix in Vite projects
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional aliases for tooling / server scripts
SUPABASE_URL=
SUPABASE_ANON_KEY=
